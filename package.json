{
  "name": "adlc-triage-agent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types src/worker-configuration.d.ts --env-file .dev.vars.example",
    "webhook:send": "node --experimental-strip-types scripts/send-test-webhook.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.12.14",
    "@flue/github": "2.0.0",
    "@flue/runtime": "2.0.0",
    "agents": "0.20.1",
    "hono": "4.12.32",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@cloudflare/vite-plugin": "^1.65.0",
    "@flue/cli": "2.0.0",
    "@flue/vite": "2.0.0",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
